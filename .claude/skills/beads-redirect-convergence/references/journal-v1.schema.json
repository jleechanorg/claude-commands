{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beads.redirect-convergence.journal.v1",
  "title": "Durable redirect transaction journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "status", "repo_id", "canonical_key", "canonical_beads", "signer_principal", "signer_fingerprint", "actions"],
  "properties": {
    "schema": {"const": "beads.redirect-convergence.journal.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PREPARED", "APPLYING", "COMMITTED", "ROLLED_BACK", "NEEDS_OPERATOR"]},
    "repo_id": {"type": "string", "minLength": 1},
    "canonical_key": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "canonical_beads": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "signer_principal": {"type": "string", "minLength": 1},
    "signer_fingerprint": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "action": {"type": "object", "additionalProperties": false, "required": ["worktree_path", "sources", "pre", "intended", "state"], "properties": {"worktree_path": {"type": "string", "pattern": "^/[^\\u0000]*$"}, "sources": {"type": "array"}, "pre": {"type": "object"}, "intended": {"type": "string"}, "state": {"enum": ["PENDING", "APPLIED", "ROLLED_BACK"]}}}
  }
}
