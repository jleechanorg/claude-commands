{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beads.redirect-convergence.journal.v1",
  "title": "Durable redirect transaction journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "status", "repo_id", "canonical_key", "canonical_beads", "canonical_device", "canonical_inode", "registry_sha256", "manifest_sha256", "plan_sha256", "adapter", "tracker_binary", "git_binary", "signer_principal", "signer_fingerprint", "actions"],
  "properties": {
    "schema": {"const": "beads.redirect-convergence.journal.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PREPARED", "APPLYING", "COMMITTED", "ROLLED_BACK", "NEEDS_OPERATOR"]},
    "repo_id": {"type": "string", "minLength": 1},
    "canonical_key": {"type": "string", "pattern": "^[0-9]+-[0-9]+$"},
    "canonical_beads": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "canonical_device": {"type": "integer", "minimum": 0},
    "canonical_inode": {"type": "integer", "minimum": 0},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "adapter": {"const": "br-sqlite-v1"},
    "tracker_binary": {"type": "object"},
    "git_binary": {"type": "object"},
    "signer_principal": {"type": "string", "minLength": 1},
    "signer_fingerprint": {"type": "string", "minLength": 1},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "action": {"type": "object", "additionalProperties": false, "required": ["worktree_path", "directory_device", "directory_inode", "sources", "pre", "intended", "state"], "properties": {"worktree_path": {"type": "string", "pattern": "^/[^\\u0000]*$"}, "directory_device": {"type": "integer", "minimum": 0}, "directory_inode": {"type": "integer", "minimum": 0}, "sources": {"type": "array"}, "pre": {"type": "object"}, "intended": {"type": "string"}, "state": {"enum": ["PENDING", "APPLIED", "ROLLED_BACK"]}}}
  }
}
