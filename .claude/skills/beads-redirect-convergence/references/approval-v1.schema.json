{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beads.redirect-convergence.approval.v1",
  "title": "Externally signed one-repository redirect approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "repo_id", "nonce", "issued_at", "expires_at", "registry_sha256", "manifest_sha256", "plan_sha256", "canonical_beads", "adapter", "tracker_binary", "git_binary", "signer_principal", "signer_fingerprint"],
  "properties": {
    "schema": {"const": "beads.redirect-convergence.approval.v1"},
    "operation": {"const": "apply"},
    "repo_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "nonce": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "pattern": "Z$"},
    "expires_at": {"type": "string", "pattern": "Z$"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_beads": {"$ref": "#/$defs/absolutePath"},
    "adapter": {"const": "br-sqlite-v1"},
    "tracker_binary": {"$ref": "#/$defs/binary"},
    "git_binary": {"$ref": "#/$defs/binary"},
    "signer_principal": {"type": "string", "minLength": 1},
    "signer_fingerprint": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "absolutePath": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binary": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
