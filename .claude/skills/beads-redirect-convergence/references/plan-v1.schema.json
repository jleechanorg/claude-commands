{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beads.redirect-convergence.plan.v1",
  "title": "Beads redirect-convergence deterministic plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "manifest_sha256", "repo_id", "adapter", "canonical_beads", "actions"
  ],
  "properties": {
    "schema": { "const": "beads.redirect-convergence.plan.v1" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repo_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "adapter": { "const": "br-sqlite-v1" },
    "canonical_beads": { "type": "string", "pattern": "^/[^\\u0000]*$" },
    "actions": { "type": "array", "items": { "type": "object" } }
  }
}
