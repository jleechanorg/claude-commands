<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jleechan.cmux-resume-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jleechan/projects/user_scope/scripts/run-cmux-resume-watchdog.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jleechan/projects/user_scope</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jleechan</string>
        <key>PATH</key>
        <string>/Users/jleechan/.local/bin:/Applications/cmux.app/Contents/Resources/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/Users/jleechan/Library/Logs/cmux-resume-watchdog.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jleechan/Library/Logs/cmux-resume-watchdog.launchd.log</string>
</dict>
</plist>

