#!/usr/bin/env python3
"""Isolated executable entry point for the convergence CLI."""

import os
import sys

_LAUNCHER = os.path.realpath(__file__)
_SCRIPTS_DIR = os.path.dirname(_LAUNCHER)
_ISOLATED_ENV = {"LANG": "C", "LC_ALL": "C", "TZ": "UTC"}


if not (sys.flags.isolated and sys.flags.no_site):
    if not os.path.isabs(sys.executable) or not os.path.isabs(_LAUNCHER):
        raise SystemExit("beads-converge: isolated Python executable is unavailable")
    try:
        os.execve(
            sys.executable,
            (sys.executable, "-I", "-S", _LAUNCHER, *sys.argv[1:]),
            _ISOLATED_ENV,
        )
    except OSError as exc:
        raise SystemExit("beads-converge: isolated Python re-exec failed") from exc

sys.path.insert(0, _SCRIPTS_DIR)


if __name__ == "__main__":
    from beads_convergence.cli import main

    raise SystemExit(main())
